# remaps
alias ls='ls -v --color=auto'
alias pushd='pushd .'
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'
alias pgrep='pgrep -l'
alias du='du -h'
alias df='df -h'
alias lsblk='lsblk -o MODEL,NAME,SIZE,MOUNTPOINT,LABEL,FSTYPE,UUID'

# short
alias l='env LC_ALL=C ls -lAXvhk --group-directories-first --color=auto'
alias o='xdg-open'
alias u='cd ..'
alias h='clear; cd'
alias r='clear; exec zsh'
alias rh='clear; cd; exec zsh'
alias p='sudo pacman --color auto'
alias s='sudo'
alias v='vim'
alias sys='sudo systemctl'

# new functions
alias lsmnt='mount | column -t'
alias vimcrypt='vim -u ~/.vimcrypt -x'

# archlinux-specific
alias upd='sudo pacman -Syu'
alias clearpkgcache='paccache -r -k 3'

# error-correcting
alias :q='exit'
alias :wq='exit'
