reset_style='\[\033[00m\]'
prompt_style=$reset_style

PS1="$prompt_style\h \W > "
# other candidates for prelude characters: 𝄞❱➪▶⊳∬⚡

# a more distinguished root style
if [[ $(id -u) == 0 ]];
    then PS1="$prompt_style\[\033[1;31m\]\h \W # "
fi

# Reset color for command output
# (this one is invoked every time before a command is executed):
trap 'echo -ne "\033[0m"' DEBUG EXIT


function prompt_command {

    # print a separator line of all screen width minus " bash HH:MM:SS" (14 chars):
    local fill
    printf -v fill '%*s' "$((COLUMNS > 14 ? COLUMNS - 14 : 0))" ''
    printf '\033[00m\033[0;90m%s bash %(%H:%M:%S)T\033[00m\n' "${fill// /-}" -1

    # If this is an xterm set the title to user@host:dir
    case "$TERM" in
    xterm*|rxvt*)
        bname=$(basename "${PWD/$HOME/~}")
        echo -ne "\033]0;${bname}: ${USER}@${HOSTNAME}: ${PWD/$HOME/~}\007"
        ;;
    *)
        ;;
    esac
}
PROMPT_COMMAND=prompt_command
